@prefix med: <https://medontoagent.example.org/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


#################################################################
# Ontology metadata
#################################################################

med:MedicalOntology
    a owl:Ontology ;
    rdfs:label "MedOntoAgent Lightweight Medical Ontology" .


#################################################################
# Core classes
#################################################################

med:ClinicalConcept
    a owl:Class ;
    rdfs:label "Clinical Concept" .


med:Condition
    a owl:Class ;
    rdfs:subClassOf med:ClinicalConcept ;
    rdfs:label "Condition" .


med:Treatment
    a owl:Class ;
    rdfs:subClassOf med:ClinicalConcept ;
    rdfs:label "Treatment" .


med:Drug
    a owl:Class ;
    rdfs:subClassOf med:Treatment ;
    rdfs:label "Drug" .


med:DrugClass
    a owl:Class ;
    rdfs:subClassOf med:Treatment ;
    rdfs:label "Drug Class" .


med:PatientGroup
    a owl:Class ;
    rdfs:subClassOf med:ClinicalConcept ;
    rdfs:label "Patient Group" .


med:Investigation
    a owl:Class ;
    rdfs:subClassOf med:ClinicalConcept ;
    rdfs:label "Investigation" .


med:Guideline
    a owl:Class ;
    rdfs:subClassOf med:ClinicalConcept ;
    rdfs:label "Guideline" .


#################################################################
# Core relationships
#################################################################

med:treatedBy
    a owl:ObjectProperty ;
    rdfs:label "treated by" ;
    rdfs:domain med:Condition ;
    rdfs:range med:Treatment .


med:recommendedFor
    a owl:ObjectProperty ;
    rdfs:label "recommended for" ;
    rdfs:domain med:Treatment ;
    rdfs:range med:PatientGroup .


med:contraindicatedIn
    a owl:ObjectProperty ;
    rdfs:label "contraindicated in" ;
    rdfs:domain med:Treatment ;
    rdfs:range med:PatientGroup .


med:notRecommendedFor
    a owl:ObjectProperty ;
    rdfs:label "not recommended for" ;
    rdfs:domain med:Treatment ;
    rdfs:range med:PatientGroup .


med:requiresInvestigation
    a owl:ObjectProperty ;
    rdfs:label "requires investigation" ;
    rdfs:domain med:Condition ;
    rdfs:range med:Investigation .


med:supportedByGuideline
    a owl:ObjectProperty ;
    rdfs:label "supported by guideline" ;
    rdfs:range med:Guideline .


#################################################################
# Provenance properties
#################################################################

med:OntologyAssertion
    a owl:Class ;
    rdfs:label "Ontology Assertion" .

med:assertionSubject
    a owl:ObjectProperty ;
    rdfs:label "assertion subject" .

med:assertionPredicate
    a owl:ObjectProperty ;
    rdfs:label "assertion predicate" .

med:assertionObject
    a owl:ObjectProperty ;
    rdfs:label "assertion object" .

med:sourceDocumentId
    a owl:DatatypeProperty ;
    rdfs:label "source document ID" ;
    rdfs:range xsd:string .


med:sourceSection
    a owl:DatatypeProperty ;
    rdfs:label "source section" ;
    rdfs:range xsd:string .


med:sourceVersion
    a owl:DatatypeProperty ;
    rdfs:label "source version" ;
    rdfs:range xsd:string .


med:assertionStatus
    a owl:DatatypeProperty ;
    rdfs:label "assertion status" ;
    rdfs:range xsd:string .


med:recommendationPriority
    a owl:DatatypeProperty ;
    rdfs:label "recommendation priority" ;
    rdfs:range xsd:integer .


med:recommendationCondition
    a owl:DatatypeProperty ;
    rdfs:label "recommendation condition" ;
    rdfs:range xsd:string .


med:applicabilityConcept
    a owl:ObjectProperty ;
    rdfs:label "applicability concept" .


#################################################################
# Initial controlled concepts
#################################################################

med:Hypertension
    a med:Condition ;
    rdfs:label "Hypertension" ;
    skos:altLabel "high blood pressure" .


med:Pregnancy
    a med:PatientGroup ;
    rdfs:label "Pregnancy" ;
    skos:altLabel "pregnant" ;
    skos:altLabel "pregnant patient" ;
    skos:altLabel "pregnant patients" ;
    skos:altLabel "pregnant person" .


med:ExampleAntihypertensiveClass
    a med:DrugClass ;
    rdfs:label "Example Antihypertensive Class" ;
    skos:altLabel "example antihypertensive" ;
    skos:altLabel "example antihypertensive drug class" .


#################################################################
# Phase 28B controlled clinical concepts
#################################################################

med:ACEInhibitor
    a med:DrugClass ;
    rdfs:label "ACE inhibitor" ;
    skos:altLabel "ACE inhibitors" ;
    skos:altLabel "angiotensin-converting enzyme inhibitor" ;
    skos:altLabel "angiotensin converting enzyme inhibitor" .


med:AngiotensinReceptorBlocker
    a med:DrugClass ;
    rdfs:label "angiotensin II receptor blocker" ;
    skos:altLabel "ARB" ;
    skos:altLabel "ARBs" ;
    skos:altLabel "angiotensin receptor blocker" ;
    skos:altLabel "angiotensin receptor blockers" .


med:Labetalol
    a med:Drug ;
    rdfs:label "labetalol" .


med:Nifedipine
    a med:Drug ;
    rdfs:label "nifedipine" .


med:Methyldopa
    a med:Drug ;
    rdfs:label "methyldopa" .


med:ChronicHypertension
    a med:Condition ;
    rdfs:label "chronic hypertension" .


med:GestationalHypertension
    a med:Condition ;
    rdfs:label "gestational hypertension" .


#################################################################
# Phase 28B NICE NG133 assertions
#
# These assertions are clinically intended for control only
# when NICE-NG133 is present, APPROVED, and current in the
# governed document registry.
#################################################################

med:ACEInhibitor
    med:notRecommendedFor med:Pregnancy .

med:AssertionNICEACEPregnancy
    a med:OntologyAssertion ;
    med:assertionSubject med:ACEInhibitor ;
    med:assertionPredicate med:notRecommendedFor ;
    med:assertionObject med:Pregnancy ;
    med:sourceDocumentId "DOC-e943ba2bdc31" ;
    med:sourceSection "Recommendation 1.3.2-1.3.3" ;
    med:sourceVersion "NG133-2026-10-11-e943ba2bdc31" ;
    med:assertionStatus "ACTIVE" .


med:AngiotensinReceptorBlocker
    med:notRecommendedFor med:Pregnancy .

med:AssertionNICEARBPregnancy
    a med:OntologyAssertion ;
    med:assertionSubject med:AngiotensinReceptorBlocker ;
    med:assertionPredicate med:notRecommendedFor ;
    med:assertionObject med:Pregnancy ;
    med:sourceDocumentId "DOC-e943ba2bdc31" ;
    med:sourceSection "Recommendation 1.3.2-1.3.3" ;
    med:sourceVersion "NG133-2026-10-11-e943ba2bdc31" ;
    med:assertionStatus "ACTIVE" .


#################################################################
# NICE NG133 - Recommendation 1.3.10
# Chronic hypertension in pregnancy
#################################################################

med:ChronicHypertension
    med:treatedBy med:Labetalol ;
    med:treatedBy med:Nifedipine ;
    med:treatedBy med:Methyldopa .


med:AssertionNICEChronicHTNLabetalol
    a med:OntologyAssertion ;
    med:assertionSubject med:ChronicHypertension ;
    med:assertionPredicate med:treatedBy ;
    med:assertionObject med:Labetalol ;
    med:sourceDocumentId "DOC-e943ba2bdc31" ;
    med:sourceSection "Recommendation 1.3.10" ;
    med:sourceVersion "NG133-2026-10-11-e943ba2bdc31" ;
    med:assertionStatus "ACTIVE" ;
    med:applicabilityConcept med:Pregnancy ;
    med:recommendationPriority 1 ;
    med:recommendationCondition "For chronic hypertension in pregnant women" .


med:AssertionNICEChronicHTNNifedipine
    a med:OntologyAssertion ;
    med:assertionSubject med:ChronicHypertension ;
    med:assertionPredicate med:treatedBy ;
    med:assertionObject med:Nifedipine ;
    med:sourceDocumentId "DOC-e943ba2bdc31" ;
    med:sourceSection "Recommendation 1.3.10" ;
    med:sourceVersion "NG133-2026-10-11-e943ba2bdc31" ;
    med:assertionStatus "ACTIVE" ;
    med:applicabilityConcept med:Pregnancy ;
    med:recommendationPriority 2 ;
    med:recommendationCondition "If labetalol is not suitable" .


med:AssertionNICEChronicHTNMethyldopa
    a med:OntologyAssertion ;
    med:assertionSubject med:ChronicHypertension ;
    med:assertionPredicate med:treatedBy ;
    med:assertionObject med:Methyldopa ;
    med:sourceDocumentId "DOC-e943ba2bdc31" ;
    med:sourceSection "Recommendation 1.3.10" ;
    med:sourceVersion "NG133-2026-10-11-e943ba2bdc31" ;
    med:assertionStatus "ACTIVE" ;
    med:applicabilityConcept med:Pregnancy ;
    med:recommendationPriority 3 ;
    med:recommendationCondition "If both labetalol and nifedipine are not suitable" .


#################################################################
# SYNTHETIC IMPLEMENTATION ASSERTION
#
# Software-development assertion only.
# Not authoritative clinical knowledge.
#################################################################

med:ExampleAntihypertensiveClass
    med:contraindicatedIn med:Pregnancy .

med:AssertionExampleContraindication
    a med:OntologyAssertion ;
    med:assertionSubject med:ExampleAntihypertensiveClass ;
    med:assertionPredicate med:contraindicatedIn ;
    med:assertionObject med:Pregnancy ;
    med:sourceDocumentId "SYNTHETIC-ONTOLOGY-TEST" ;
    med:sourceSection "Implementation Test" ;
    med:sourceVersion "1.0" ;
    med:assertionStatus "SYNTHETIC_TEST_ONLY" .

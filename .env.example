# MedOntoAgent configuration template
# Copy this file to .env for local development.
# Never commit real credentials.

APP_NAME=MedOntoAgent API
APP_VERSION=0.1.0
APP_ENV=development

AWS_REGION=ap-south-1

QDRANT_COLLECTION=medontoagent_clinical_documents

RETRIEVAL_TOP_K=5
MAX_AGENT_RETRIES=1

LOG_LEVEL=INFO

# Future secrets will be added when their phases are implemented:
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# QDRANT_URL=YOUR_QDRANT_URL
# QDRANT_API_KEY=YOUR_QDRANT_API_KEY
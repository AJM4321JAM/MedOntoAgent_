# MedOntoAgent configuration template
# Copy this file to .env for local development.
# Never commit real credentials.

APP_NAME=MedOntoAgent API
APP_VERSION=0.1.0
APP_ENV=development

AWS_REGION=ap-south-1

# Qdrant Cloud
QDRANT_URL=YOUR_QDRANT_URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=medontoagent_clinical_documents

# Retrieval and orchestration
RETRIEVAL_TOP_K=5
MAX_AGENT_RETRIES=1

# Chunking
MAX_CHUNK_WORDS=600
CHUNK_OVERLAP_WORDS=80

# Logging
LOG_LEVEL=INFO

# OpenRouter
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Offline Ragas evaluator
# Reuses OPENROUTER_API_KEY and OPENROUTER_BASE_URL.
RAGAS_EVALUATOR_MODEL=openrouter/free

# LLM limits
LLM_MAX_OUTPUT_TOKENS=1000
LLM_TIMEOUT_SECONDS=60

# Local embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Security
ADMIN_API_KEY=
ENABLE_DEV_ROUTES=false
MAX_REQUEST_BYTES=65536

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=medontoagent
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORT_INTERVAL_MS=10000
